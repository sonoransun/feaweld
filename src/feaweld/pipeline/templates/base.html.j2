<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{% block title %}feaweld Report{% endblock %}</title>
    {% if plotly_cdn %}<script src="https://cdn.plot.ly/plotly-2.27.0.min.js" charset="utf-8"></script>
    {% endif %}{% block head_extra %}{% endblock %}
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; margin: 40px; color: #333; }
        h1 { color: #1a5276; border-bottom: 2px solid #2980b9; padding-bottom: 10px; }
        h2 { color: #2471a3; margin-top: 30px; }
        table { border-collapse: collapse; width: 100%; margin: 15px 0; }
        th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }
        th { background-color: #2980b9; color: white; }
        tr:nth-child(even) { background-color: #f2f2f2; }
        .pass { color: #27ae60; font-weight: bold; }
        .fail { color: #e74c3c; font-weight: bold; }
        .warning { color: #f39c12; font-weight: bold; }
        .positive { color: #e74c3c; }
        .negative { color: #27ae60; }
        .summary-box { background: #eaf2f8; padding: 15px; border-radius: 5px; margin: 15px 0; }
        .error-box { background: #fadbd8; padding: 15px; border-radius: 5px; margin: 15px 0; }
        .warning-box { background: #fdf2e0; padding: 15px; border-radius: 5px; margin: 15px 0; }
        .section { margin: 20px 0; }
        img { max-width: 100%; margin: 10px 0; }
        .figure-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin: 15px 0; }
        .figure-item { text-align: center; }
        .figure-item img { border: 1px solid #ddd; border-radius: 4px; }
        .figure-caption { font-style: italic; color: #555; margin-top: 5px; font-size: 0.9em; }
        .figure-full { margin: 15px 0; text-align: center; }
        .figure-full img { border: 1px solid #ddd; border-radius: 4px; }
        body.comparison th { text-align: center; }
        body.comparison td { text-align: right; }
        body.comparison td:first-child { text-align: left; font-weight: bold; }
        footer { margin-top: 40px; color: #888; font-size: 0.9em; border-top: 1px solid #ddd; padding-top: 10px; }
    </style>
</head>
<body class="{{ body_class | default('report') }}">
    <h1>{% block heading %}feaweld Analysis Report{% endblock %}</h1>
    {% block content %}{% endblock %}
    <footer>
        Generated by feaweld v{{ version }} on {{ timestamp }}
    </footer>
</body>
</html>
