{% extends "base.html.j2" %}
{% from "_macros.html.j2" import figure_section %}

{% block title %}feaweld Analysis Report - {{ title }}{% endblock %}
{% block heading %}feaweld Analysis Report{% endblock %}

{% block content %}
{% if case %}
<div class="section">
    <h2>Analysis Case</h2>
    <div class="summary-box">
        <strong>Name:</strong> {{ case.name }}<br>
        <strong>Description:</strong> {{ case.description or "N/A" }}<br>
        <strong>Joint Type:</strong> {{ case.joint_type }}<br>
        <strong>Material:</strong> {{ case.base_metal }} (base), {{ case.weld_metal }} (weld)<br>
        <strong>Solver:</strong> {{ case.solver_type }} ({{ case.backend }})<br>
        <strong>Status:</strong> <span class="{{ 'pass' if case.success else 'fail' }}">{{ 'PASS' if case.success else 'ERRORS' }}</span>
    </div>
</div>
{% endif %}

{% if mesh %}
<div class="section">
    <h2>Mesh Summary</h2>
    <table>
        <tr><th>Property</th><th>Value</th></tr>
        <tr><td>Number of Nodes</td><td>{{ "{:,}".format(mesh.n_nodes) }}</td></tr>
        <tr><td>Number of Elements</td><td>{{ "{:,}".format(mesh.n_elements) }}</td></tr>
        <tr><td>Element Type</td><td>{{ mesh.element_type }}</td></tr>
        <tr><td>Dimensions</td><td>{{ mesh.ndim }}D</td></tr>
        <tr><td>Physical Groups</td><td>{{ mesh.physical_groups or "None" }}</td></tr>
    </table>
</div>
{% endif %}

{% if fea_rows %}
<div class="section">
    <h2>FEA Results</h2>
    <table>
        <tr><th>Quantity</th><th>Value</th></tr>
        {% for label, value in fea_rows %}
        <tr><td>{{ label }}</td><td>{{ value }}</td></tr>
        {% endfor %}
    </table>
</div>
{% endif %}

{% if postprocess_rows %}
<div class="section">
    <h2>Post-Processing Results</h2>
    <table>
        <tr><th>Method</th><th>Parameter</th><th>Value</th></tr>
        {% for method, param, value in postprocess_rows %}
        <tr><td>{{ method }}</td><td>{{ param }}</td><td>{{ value }}</td></tr>
        {% endfor %}
    </table>
</div>
{% endif %}

{% if fatigue_rows %}
<div class="section">
    <h2>Fatigue Assessment</h2>
    <table>
        <tr><th>Method</th><th>Parameter</th><th>Value</th></tr>
        {% for method, param, value in fatigue_rows %}
        <tr><td>{{ method }}</td><td>{{ param }}</td><td>{{ value }}</td></tr>
        {% endfor %}
    </table>
</div>
{% endif %}

{% if probabilistic_rows %}
<div class="section">
    <h2>Probabilistic Analysis</h2>
    <table>
        <tr><th>Statistic</th><th>Value</th></tr>
        {% for stat, value in probabilistic_rows %}
        <tr><td>{{ stat }}</td><td>{{ value }}</td></tr>
        {% endfor %}
    </table>
</div>
{% endif %}

{{ figure_section(figures) }}

{% if interactive_figures %}
<div class="section">
    <h2>Interactive Figures</h2>
    {% for fig in interactive_figures %}
    <div class="figure-full">{{ fig.fragment | safe }}<div class="figure-caption">{{ fig.caption }}</div></div>
    {% endfor %}
</div>
{% endif %}

{% if warnings %}
<div class="warning-box">
    <h2>Warnings</h2>
    <ul>
        {% for warning in warnings %}
        <li>{{ warning }}</li>
        {% endfor %}
    </ul>
</div>
{% endif %}

{% if errors %}
<div class="error-box">
    <h2>Errors</h2>
    <ul>
        {% for error in errors %}
        <li>{{ error }}</li>
        {% endfor %}
    </ul>
</div>
{% endif %}
{% endblock %}
