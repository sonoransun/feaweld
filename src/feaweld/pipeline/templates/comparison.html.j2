{% extends "base.html.j2" %}
{% from "_macros.html.j2" import figure_section %}

{% block title %}feaweld Comparison Report - {{ title }}{% endblock %}
{% block heading %}Parametric Study Comparison: {{ title }}{% endblock %}

{% block content %}
<div class="summary-box">
    <h2>Study Overview</h2>
    <strong>Name:</strong> {{ overview.study_name }}<br>
    <strong>Total cases:</strong> {{ overview.n_cases }}<br>
    <strong>Succeeded:</strong> {{ overview.n_succeeded }}<br>
    <strong>Failed:</strong> {{ overview.n_failed }}<br>
    <strong>Elapsed:</strong> {{ overview.elapsed }} s
</div>

{% if metric_table %}
<div class="section">
    <h2>Metric Comparison</h2>
    <table>
        <tr>{% for header in metric_table.headers %}<th>{{ header }}</th>{% endfor %}</tr>
        {% for row in metric_table.rows %}
        <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
        {% endfor %}
    </table>
</div>
{% endif %}

{% if delta_table %}
<div class="section">
    <h2>Deltas vs. Baseline ({{ delta_table.baseline }})</h2>
    <table>
        <tr>{% for header in delta_table.headers %}<th>{{ header }}</th>{% endfor %}</tr>
        {% for row in delta_table.rows %}
        <tr>{% for cell in row %}<td{% if cell.cls %} class="{{ cell.cls }}"{% endif %}>{{ cell.text }}</td>{% endfor %}</tr>
        {% endfor %}
    </table>
</div>
{% endif %}

{{ figure_section(figures) }}

{% if failed_cases %}
<div class="error-box">
    <h2>Failed Cases ({{ failed_cases | length }})</h2>
    <ul>
        {% for name, message in failed_cases %}
        <li><b>{{ name }}:</b> {{ message }}</li>
        {% endfor %}
    </ul>
</div>
{% endif %}
{% endblock %}
